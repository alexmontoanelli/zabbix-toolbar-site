---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="container section notfound">
    <p class="eyebrow">404</p>
    <h1>This page went stale.</h1>
    <p class="lede">The page you're looking for doesn't exist or has moved.</p>
    <p class="actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn btn-secondary" href="/docs/">Read the docs</a>
    </p>
  </section>
</Base>

<style>
  .notfound { text-align: center; min-height: 50vh; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
</style>
