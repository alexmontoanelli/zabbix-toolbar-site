---
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, jsonLd, noindex = false, ogImage: ogPath = '/og-image.png', ogType = 'website' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(ogPath, Astro.site).href;
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161618" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // Mockups ao vivo: relógio da barra de menus e início dos problemas no fuso do visitante.
      import { formatMenuBarClock, formatStarted, startedAt } from '../lib/clock';

      function update() {
        const now = new Date();
        for (const el of document.querySelectorAll<HTMLElement>('[data-live-clock]')) el.textContent = formatMenuBarClock(now);
        for (const el of document.querySelectorAll<HTMLElement>('[data-live-started]')) {
          el.textContent = formatStarted(startedAt(now, Number(el.dataset.liveStarted)));
        }
      }
      update();
      setInterval(update, 15_000);
    </script>
  </body>
</html>
