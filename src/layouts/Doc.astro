---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import { site } from '../data/site';

interface Props { title: string; description: string; currentId: string }
const { title, description, currentId } = Astro.props;
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const href = (id: string) => (id === 'index' ? '/docs/' : `/docs/${id}/`);
---
<Base title={title} description={description}>
  <div class="container layout">
    <nav class="side" aria-label="Documentation">
      <p class="side-title">Docs</p>
      <ul>
        {docs.map((doc) => (
          <li><a href={href(doc.id)} aria-current={doc.id === currentId ? 'page' : undefined}>{doc.data.title}</a></li>
        ))}
        <li><a href="/faq/">FAQ</a></li>
      </ul>
    </nav>
    <article class="prose">
      <h1>{title}</h1>
      <slot />
      <hr />
      <p class="muted">Something missing or wrong? <a href={site.links.support}>Open an issue</a>.</p>
    </article>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 56px; padding-top: 48px; padding-bottom: 48px; }
  @media (max-width: 860px) { .layout { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .side { position: sticky; top: 84px; align-self: start; }
  @media (max-width: 860px) { .side { position: static; } }
  .side-title { font: 600 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); margin: 0 0 10px; }
  .side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (max-width: 860px) { .side ul { display: flex; flex-wrap: wrap; gap: 6px; } }
  .side a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--text-2); text-decoration: none; font-size: 0.95rem; }
  .side a:hover { background: var(--bg-sunken); color: var(--text); }
  .side a[aria-current='page'] { background: var(--accent-soft); color: var(--text); font-weight: 600; }
  @media (max-width: 860px) { .side a { border: 1px solid var(--line); } }
  hr { border: 0; border-top: 1px solid var(--line); margin: 48px 0 16px; }
</style>
