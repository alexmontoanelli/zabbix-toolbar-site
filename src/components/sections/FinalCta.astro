---
import { site } from '../../data/site';
---
<section class="section final">
  <div class="container inner">
    <img src="/icon-512.png" width="96" height="96" alt="" loading="lazy" />
    <h2>Stop refreshing the Zabbix dashboard.</h2>
    <p class="lede">Free for one server. {site.requirements}.</p>
    <div class="ctas">
      <a class="btn btn-primary btn-lg" href={site.links.appStore}>Download on the Mac App Store</a>
      <a class="btn btn-secondary btn-lg" href="/#pricing">See Pro</a>
    </div>
  </div>
</section>

<style>
  .inner { text-align: center; display: grid; justify-items: center; }
  img { border-radius: 22px; box-shadow: var(--shadow); margin-bottom: 24px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
</style>
