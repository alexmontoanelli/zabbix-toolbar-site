---
import type { FaqItem } from '../../data/faq';

interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p set:html={item.a} />
    </details>
  ))}
</div>

<style>
  .faq { max-width: 760px; margin: 0 auto; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 18px 32px 18px 0; font-weight: 600; list-style: none; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 14px; font: 400 1.5rem var(--font-mono); color: var(--text-3); }
  details[open] summary::after { content: '−'; }
  p { margin: 0 0 18px; color: var(--text-2); }
</style>
