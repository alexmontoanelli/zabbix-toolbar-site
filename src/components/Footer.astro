---
import { site } from '../data/site';

const year = new Date().getFullYear();
const columns = [
  { title: 'Product', links: [
    { href: '/#features', label: 'Features' },
    { href: '/#pricing', label: 'Pricing' },
    { href: site.links.download, label: 'Download' },
    { href: site.links.releases, label: 'Changelog' },
  ] },
  { title: 'Help', links: [
    { href: '/docs/', label: 'Docs' },
    { href: '/faq/', label: 'FAQ' },
    { href: site.links.support, label: 'Support' },
    { href: site.links.customerPortal, label: 'Manage subscription' },
  ] },
  { title: 'Legal', links: [
    { href: '/privacy/', label: 'Privacy Policy' },
    { href: '/terms/', label: 'Terms of Use' },
  ] },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <a class="brand" href="/"><img src="/icon-64.png" width="24" height="24" alt="" /> {site.name}</a>
        <p class="muted">Zabbix problems in your Mac menu bar. {site.requirements}.</p>
      </div>
      {columns.map((column) => (
        <div>
          <h2 class="col-title">{column.title}</h2>
          <ul>{column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="legal muted">
      © {year} {site.author}. Zabbix is a registered trademark of Zabbix SIA. Zabbix Toolbar is an
      independent product and is not affiliated with or endorsed by Zabbix SIA. macOS is a trademark of Apple Inc.
    </p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-sunken); padding: 48px 0 32px; margin-top: 40px; }
  .top { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 32px; }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--text); text-decoration: none; font: 600 1rem var(--font-display); }
  .brand img { border-radius: 6px; }
  .col-title { font: 600 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  ul a { color: var(--text-2); text-decoration: none; font-size: 0.95rem; }
  ul a:hover { color: var(--text); text-decoration: underline; }
  .legal { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 0.82rem; }
</style>
