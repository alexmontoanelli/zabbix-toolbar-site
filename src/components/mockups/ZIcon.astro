---
import Swap from './Swap.astro';
import { uid } from '../../lib/ids';

interface Props { state?: 'normal' | 'alert' | 'error'; count?: number; countFrom?: number }
const { state = 'normal', count, countFrom } = Astro.props;
const color = state === 'alert' ? 'var(--mk-red)' : state === 'error' ? 'var(--mk-yellow)' : 'currentColor';
const maskId = uid('zmask');
const z = 'M4.5 4.5H11.5L4.5 11.5H11.5';
---
<span class="zicon" style={`color:${color}`}>
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    {state === 'normal' ? (
      <g fill="none" stroke="currentColor">
        <rect x="0.75" y="0.75" width="14.5" height="14.5" rx="3" stroke-width="1.5" />
        <path d={z} stroke-width="1.8" stroke-linecap="square" />
      </g>
    ) : (
      <>
        <mask id={maskId}>
          <rect width="16" height="16" fill="white" />
          <path d={z} fill="none" stroke="black" stroke-width="1.8" stroke-linecap="square" />
        </mask>
        <rect width="16" height="16" rx="3" fill="currentColor" mask={`url(#${maskId})`} />
      </>
    )}
  </svg>
  {state === 'alert' && count !== undefined && <span class="count"><Swap to={count} from={countFrom} /></span>}
</span>

<style>
  .zicon { display: inline-flex; align-items: center; gap: 3px; }
  .count { font: 700 12px/1 ui-monospace, 'SF Mono', Menlo, monospace; font-variant-numeric: tabular-nums; }
</style>
